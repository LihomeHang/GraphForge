# GraphForge 环境变量示例。复制为 .env 后填写。
# LLM (OpenAI 兼容)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o-mini

# Embedding（缺省复用 LLM 配置）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Neo4j / Qdrant
NEO4J_PASSWORD=graphforge-dev

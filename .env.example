# GraphForge 环境变量示例。复制为 .env 后填写。
# LLM (OpenAI 兼容)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o-mini

# Embedding（缺省复用 LLM 配置）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=            # 缺省自动探测（mock 模式为 32）

# Neo4j / Qdrant
NEO4J_PASSWORD=graphforge-dev
# QDRANT_API_KEY=           # Qdrant 开启鉴权时必填

# 可选调优（有合理默认值，见 README 配置表）
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# LLM_CONCURRENCY=4
# RESOLVE_SIM_THRESHOLD=0.85

# GraphForge 环境变量示例。复制为 .env 后填写。
# LLM (OpenAI 兼容)
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Embedding（缺省复用 LLM 配置）
EMBEDDING_PROVIDER=auto     # auto=远程失败切本地；remote=仅远程；local=纯本地
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=            # 缺省自动探测（mock 模式为 32）
# EMBEDDING_BATCH_SIZE=128   # 单次请求最多文本数，避免大图谱超时
# EMBEDDING_CONCURRENCY=4    # Embedding 批次并发数
# EMBEDDING_MAX_RETRIES=2    # 超时、网络错误、429/5xx 重试次数
# LOCAL_EMBEDDING_DIM=1024   # 纯本地哈希向量维度

# Neo4j / Qdrant
NEO4J_PASSWORD=
# QDRANT_API_KEY=           # Qdrant 开启鉴权时必填

# 可选调优（有合理默认值，见 README 配置表）
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=100
# LLM_CONCURRENCY=8
# EXTRACT_BATCH_SIZE=4
# RESOLVE_SIM_THRESHOLD=0.85
# RESOLVE_CANDIDATE_K=8
